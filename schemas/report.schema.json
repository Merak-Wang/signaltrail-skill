{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/daily-intelligence-report.schema.json",
  "title": "SignalTrail Report",
  "type": "object",
  "required": [
    "report_id",
    "date",
    "edition",
    "revision",
    "generated_at",
    "title",
    "executive_summary",
    "sections",
    "analyses",
    "changes",
    "pending_verifications",
    "source_count",
    "event_count"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "2.0"]
    },
    "report_id": {
      "type": "string",
      "minLength": 5
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "edition": {
      "enum": [
        "daily",
        "morning",
        "evening"
      ]
    },
    "language": {
      "enum": ["zh-CN", "en"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "executive_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 10
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "category",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "title",
                "tldr",
                "why_it_matters",
                "importance",
                "importance_reason",
                "importance_breakdown",
                "confidence",
                "status",
                "source_refs",
                "evidence_notes",
                "tags"
              ],
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "tldr": {
                  "type": "string",
                  "minLength": 20
                },
                "why_it_matters": {
                  "type": "string",
                  "minLength": 10
                },
                "importance": {"$ref": "#/$defs/importanceScore"},
                "confidence": {"$ref": "#/$defs/confidence"},
                "status": {"$ref": "#/$defs/eventStatus"},
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/sourceReference"}
                },
                "evidence_notes": {"$ref": "#/$defs/textList"},
                "tags": {"$ref": "#/$defs/textList"},
                "importance_breakdown": {
                  "type": "object",
                  "required": [
                    "impact",
                    "freshness",
                    "relevance",
                    "source_quality",
                    "corroboration",
                    "novelty",
                    "continuity"
                  ],
                  "properties": {
                    "impact": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30
                    },
                    "freshness": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "relevance": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "source_quality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "corroboration": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "novelty": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "continuity": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "additionalProperties": false
                },
                "importance_reason": {
                  "type": "string",
                  "minLength": 10
                },
                "primary_source": {"$ref": "#/$defs/primarySource"},
                "image": {
                  "type": "object",
                  "required": ["url", "caption", "credit"],
                  "properties": {
                    "url": {"type": "string", "format": "uri"},
                    "caption": {"type": "string"},
                    "credit": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          },
          "briefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "title",
                "tldr",
                "importance",
                "status",
                "primary_source",
                "source_ref"
              ],
              "properties": {
                "item_id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "title_zh": {"type": "string", "minLength": 2},
                "title_en": {"type": "string", "minLength": 2},
                "tldr": {"type": "string", "minLength": 10},
                "importance": {"type": "integer", "minimum": 0, "maximum": 100},
                "status": {
                  "enum": ["NEW", "UPD", "CONF", "REV", "WATCH", "CLOSED"]
                },
                "primary_source": {
                  "type": "object",
                  "required": ["id", "name", "url"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "format": "uri"}
                  },
                  "additionalProperties": false
                },
                "source_ref": {
                  "type": "object",
                  "required": ["item_id", "title", "url", "access", "role"],
                  "properties": {
                    "item_id": {"type": "string", "minLength": 1},
                    "title": {"type": "string", "minLength": 1},
                    "url": {"type": "string", "format": "uri"},
                    "access": {
                      "enum": [
                        "full_text",
                        "partial",
                        "metadata_only",
                        "verification_required"
                      ]
                    },
                    "role": {"type": "string", "minLength": 1},
                    "published_at": {"type": "string"},
                    "collected_at": {"type": "string"}
                  },
                  "additionalProperties": true
                },
                "image": {
                  "type": "object",
                  "required": [
                    "source_url",
                    "resolved_url",
                    "local_path",
                    "content_type",
                    "sha256",
                    "byte_size",
                    "width",
                    "height",
                    "caption",
                    "credit"
                  ],
                  "properties": {
                    "source_url": {"type": "string", "format": "uri"},
                    "resolved_url": {"type": "string", "format": "uri"},
                    "local_path": {
                      "type": "string",
                      "pattern": "^media/images/[0-9a-f]{2}/[0-9a-f]{64}\\.(jpg|png|gif|webp)$"
                    },
                    "content_type": {
                      "enum": ["image/jpeg", "image/png", "image/gif", "image/webp"]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byte_size": {"type": "integer", "minimum": 1, "maximum": 20971520},
                    "width": {"type": "integer", "minimum": 1},
                    "height": {"type": "integer", "minimum": 1},
                    "caption": {"type": "string"},
                    "credit": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "featured_event_id": {"type": "string"},
                "evidence_note": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "coverage_note": {
            "type": "string"
          },
          "module": {
            "enum": [
              "information",
              "technology"
            ]
          },
          "category": {
            "enum": [
              "international",
              "domestic",
              "military",
              "economy",
              "market",
              "technology",
              "news",
              "papers",
              "open_source"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "analysis_id",
          "domain",
          "claim",
          "confidence",
          "evidence_event_ids",
          "counter_evidence",
          "implications",
          "watch_signals",
          "state_change"
        ],
        "properties": {
          "analysis_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "facts": {"$ref": "#/$defs/requiredTextList"},
          "reasoning": {
            "type": "string",
            "minLength": 10
          },
          "confidence": {"$ref": "#/$defs/confidence"},
          "evidence_event_ids": {"$ref": "#/$defs/textList"},
          "counter_evidence": {"$ref": "#/$defs/textList"},
          "scenarios": {"$ref": "#/$defs/requiredTextList"},
          "scenario_basis": {
            "type": "string",
            "minLength": 10
          },
          "implications": {"$ref": "#/$defs/textList"},
          "actions": {"$ref": "#/$defs/requiredTextList"},
          "watch_signals": {"$ref": "#/$defs/textList"},
          "invalidation_signals": {"$ref": "#/$defs/requiredTextList"},
          "state_change": {
            "enum": [
              "new",
              "strengthening",
              "unchanged",
              "weakening",
              "revised",
              "invalidated",
              "closed"
            ]
          },
          "domain": {
            "enum": [
              "geopolitics",
              "markets",
              "ai_technology"
            ]
          },
          "assessment_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "trend",
                "risk",
                "learning_research"
              ]
            }
          },
          "perspectives": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "geopolitics",
                "ai_research_engineering",
                "equity_analysis",
                "china_standpoint",
                "western_standpoint"
              ]
            }
          },
          "narrative": {
            "type": "string",
            "minLength": 100
          },
          "dialectical_analysis": {
            "type": "string",
            "minLength": 20
          },
          "historical_context": {
            "type": "string",
            "minLength": 20
          },
          "stakeholder_positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stakeholder", "position", "interests"],
              "properties": {
                "stakeholder": {"type": "string", "minLength": 1},
                "position": {"type": "string", "minLength": 1},
                "interests": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "time_horizon": {
            "type": "string",
            "minLength": 1
          },
          "causal_chain": {"$ref": "#/$defs/multiEntryTextList"},
          "assumptions": {"$ref": "#/$defs/nonemptyTextList"},
          "evidence_gaps": {"$ref": "#/$defs/nonemptyTextList"},
          "confidence_rationale": {
            "type": "string",
            "minLength": 10
          },
          "change_from_prior": {
            "type": "string",
            "minLength": 10
          },
          "decision_relevance": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": true
      }
    },
    "analysis_protocol_version": {
      "enum": ["2.0"]
    },
    "cross_perspective_synthesis": {
      "type": "object",
      "required": [
        "overall_judgment",
        "consensus",
        "tensions",
        "transmission_chain",
        "shared_watch_signals",
        "revision_triggers",
        "evidence_event_ids"
      ],
      "properties": {
        "overall_judgment": {
          "type": "string",
          "minLength": 20
        },
        "consensus": {"$ref": "#/$defs/nonemptyTextList"},
        "tensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["issue", "perspectives", "source_of_difference"],
            "properties": {
              "issue": {"type": "string", "minLength": 1},
              "perspectives": {"$ref": "#/$defs/multiEntryTextList"},
              "source_of_difference": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "transmission_chain": {"$ref": "#/$defs/multiEntryTextList"},
        "shared_watch_signals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision_triggers": {"$ref": "#/$defs/nonemptyTextList"},
        "evidence_event_ids": {"$ref": "#/$defs/nonemptyTextList"}
      },
      "additionalProperties": false
    },
    "changes": {"$ref": "#/$defs/textList"},
    "tomorrow_watch_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending_verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_name",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      }
    },
    "source_count": {"$ref": "#/$defs/nonnegativeInteger"},
    "event_count": {"$ref": "#/$defs/nonnegativeInteger"},
    "brief_count": {"$ref": "#/$defs/nonnegativeInteger"},
    "source_metrics": {
      "type": "object",
      "properties": {
        "configured": {"$ref": "#/$defs/nonnegativeInteger"},
        "successful": {"$ref": "#/$defs/nonnegativeInteger"},
        "represented": {"$ref": "#/$defs/nonnegativeInteger"},
        "pending": {"$ref": "#/$defs/nonnegativeInteger"}
      },
      "additionalProperties": false
    },
    "evaluation_status": {
      "enum": ["pending", "completed", "failed"]
    },
    "quality_evaluation": {
      "type": "object",
      "required": [
        "evaluator_role",
        "evaluated_report_id",
        "dimensions",
        "total_score",
        "main_defects",
        "insufficient_evidence",
        "improvements",
        "continuity_decision",
        "exclude_from_continuity"
      ],
      "properties": {
        "evaluator_role": {"const": "independent"},
        "evaluated_report_id": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "score", "finding"],
            "properties": {
              "id": {
                "enum": [
                  "coverage",
                  "importance_ordering",
                  "factual_reliability",
                  "summary_accuracy",
                  "analysis_traceability",
                  "historical_continuity",
                  "readability",
                  "timeliness",
                  "compliance_boundaries"
                ]
              },
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "finding": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "total_score": {"type": "integer", "minimum": 9, "maximum": 45},
        "main_defects": {"$ref": "#/$defs/textList"},
        "insufficient_evidence": {"$ref": "#/$defs/textList"},
        "improvements": {"$ref": "#/$defs/textList"},
        "continuity_decision": {"enum": ["accept", "selective", "reject"]},
        "exclude_from_continuity": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["formatting", "event_summaries", "analyses", "source_access", "all"]
          }
        }
      },
      "additionalProperties": false
    },
    "media_metrics": {
      "type": "object",
      "required": [
        "candidates",
        "attached",
        "unique_files",
        "reused_files",
        "failed",
        "skipped_budget",
        "total_bytes"
      ],
      "properties": {
        "candidates": {"$ref": "#/$defs/nonnegativeInteger"},
        "attached": {"$ref": "#/$defs/nonnegativeInteger"},
        "unique_files": {"$ref": "#/$defs/nonnegativeInteger"},
        "reused_files": {"$ref": "#/$defs/nonnegativeInteger"},
        "preserved_without_image": {"$ref": "#/$defs/nonnegativeInteger"},
        "failed": {"$ref": "#/$defs/nonnegativeInteger"},
        "skipped_budget": {"$ref": "#/$defs/nonnegativeInteger"},
        "total_bytes": {"$ref": "#/$defs/nonnegativeInteger"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "primarySource": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "item_id",
        "title",
        "url",
        "access",
        "role"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "access": {
          "$ref": "#/$defs/sourceAccess"
        },
        "role": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "collected_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "eventStatus": {
      "enum": [
        "NEW",
        "UPD",
        "CONF",
        "REV",
        "WATCH",
        "CLOSED"
      ]
    },
    "sourceAccess": {
      "enum": [
        "full_text",
        "partial",
        "metadata_only",
        "verification_required"
      ]
    },
    "importanceScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "textList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredTextList": {"$ref": "#/$defs/textList", "minItems": 1},
    "nonemptyStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonemptyTextList": {"$ref": "#/$defs/nonemptyStrings", "minItems": 1},
    "multiEntryTextList": {"$ref": "#/$defs/nonemptyStrings", "minItems": 2},
    "nonnegativeInteger": {"type": "integer", "minimum": 0}
  }
}
